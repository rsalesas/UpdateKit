{
  "sourceLanguage" : "en-GB",
  "strings" : {
    "%@ can't write to %@, so it can't replace itself." : {
      "comment" : "Why the app can't update in place. The arguments are the app's name and a folder name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ kann nicht in %2$@ schreiben und sich daher nicht selbst ersetzen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't write to %2$@, so it can't replace itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ no puede escribir en %2$@, así que no puede sustituirse a sí misma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ne peut pas écrire dans %2$@ et ne peut donc pas se remplacer."
          }
        }
      }
    },
    "Couldn't download the update: %@" : {
      "comment" : "Update error. The argument is a short lower-case reason, e.g. \"the server returned 404\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Update konnte nicht geladen werden: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo descargar la actualización: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de télécharger la mise à jour : %@"
          }
        }
      }
    },
    "Couldn't replace the installed app: %@" : {
      "comment" : "Update error. The argument is a short lower-case reason.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die installierte App konnte nicht ersetzt werden: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo sustituir la app instalada: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de remplacer l’app installée : %@"
          }
        }
      }
    },
    "Downloading — %@" : {
      "comment" : "Update progress when the total size is unknown. The argument is the amount downloaded so far, e.g. \"1.2 MB\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird geladen – %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descargando — %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Téléchargement — %@"
          }
        }
      }
    },
    "Downloading — %@ of %@" : {
      "comment" : "Update progress. The arguments are the amount downloaded so far and the total, e.g. \"1.2 MB of 5 MB\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird geladen – %1$@ von %2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Downloading — %1$@ of %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descargando — %1$@ de %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Téléchargement — %1$@ sur %2$@"
          }
        }
      }
    },
    "Move %@ to your Applications folder to update it in place." : {
      "comment" : "Why the app can't update in place: it is running from a disk image or a quarantined location. The argument is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewege %@ in deinen Ordner „Programme“, um es direkt zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traslada %@ a tu carpeta Aplicaciones para poder actualizarla ahí mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Placez %@ dans votre dossier Applications pour pouvoir le mettre à jour sur place."
          }
        }
      }
    },
    "Relaunching…" : {
      "comment" : "Update progress, as the app quits to reopen as the new version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird neu gestartet …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volviendo a abrir…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relance…"
          }
        }
      }
    },
    "The download didn't contain an app." : {
      "comment" : "Update error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Download enthielt keine App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La descarga no contenía ninguna app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le téléchargement ne contenait aucune app."
          }
        }
      }
    },
    "The download didn't match its published checksum, so it wasn't installed." : {
      "comment" : "Update error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Download stimmte nicht mit seiner veröffentlichten Prüfsumme überein und wurde daher nicht installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La descarga no coincidía con su suma de comprobación publicada, así que no se instaló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le téléchargement ne correspondait pas à sa somme de contrôle publiée ; il n’a donc pas été installé."
          }
        }
      }
    },
    "The download is version %@, which isn't newer." : {
      "comment" : "Update error. The argument is a version number, e.g. \"1.4.2\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Download hat die Version %@, die nicht neuer ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La descarga es la versión %@, que no es más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le téléchargement est la version %@, qui n’est pas plus récente."
          }
        }
      }
    },
    "The download isn't correctly signed: %@" : {
      "comment" : "Update error. The argument is a short lower-case reason, e.g. \"it isn't signed\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Download ist nicht korrekt signiert: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La descarga no está firmada correctamente: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le téléchargement n’est pas correctement signé : %@"
          }
        }
      }
    },
    "The downloaded archive couldn't be expanded." : {
      "comment" : "Update error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das geladene Archiv konnte nicht entpackt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo descomprimir el archivo descargado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’archive téléchargée n’a pas pu être décompressée."
          }
        }
      }
    },
    "The update server returned status %lld." : {
      "comment" : "Update check error. The argument is an HTTP status code, e.g. 404.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Update-Server hat den Status %lld zurückgegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor de actualizaciones devolvió el estado %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le serveur de mise à jour a renvoyé le code %lld."
          }
        }
      }
    },
    "The updater helper is missing from this build." : {
      "comment" : "Why an update can't be installed in place.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Update-Hilfsprogramm fehlt in diesem Build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Falta el asistente de actualización en esta compilación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’assistant de mise à jour est absent de cette compilation."
          }
        }
      }
    },
    "This build of %@ is sandboxed, so it cannot replace itself in %@." : {
      "comment" : "Why the app can't update in place. The arguments are the app's name and a folder name, e.g. \"Applications\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Build von %1$@ läuft in einer Sandbox und kann sich daher nicht selbst in %2$@ ersetzen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This build of %1$@ is sandboxed, so it cannot replace itself in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta compilación de %1$@ está en un entorno aislado, así que no puede sustituirse a sí misma en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette compilation de %1$@ est en sandbox ; elle ne peut donc pas se remplacer dans %2$@."
          }
        }
      }
    },
    "This update doesn't publish an archive the app can install." : {
      "comment" : "Why an update can't be installed in place.",
