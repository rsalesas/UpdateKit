{
  "sourceLanguage" : "en-GB",
  "strings" : {
    "%@ %@ is available" : {
      "comment" : "An update has been published. The arguments are the app's name and the new version number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ ist verfügbar"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is available"
          }
        }
      }
    },
    "%@ %@ is the latest version." : {
      "comment" : "Alert text after Check for Updates finds nothing newer. The arguments are the app's name and its version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@ ist die neueste Version."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is the latest version."
          }
        }
      }
    },
    "%@ Downloading opens the disk image — drag %@ to your Applications folder to finish installing it." : {
      "comment" : "Update dialog. The first argument is a whole sentence saying why the app can't update itself; the second is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Nach dem Herunterladen öffnet sich das Disk-Image – ziehe %2$@ in deinen Ordner „Programme“, um die Installation abzuschließen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Downloading opens the disk image — drag %2$@ to your Applications folder to finish installing it."
          }
        }
      }
    },
    "%@ Drag %@ to your Applications folder to install it." : {
      "comment" : "Tooltip on the Download Disk Image button. The first argument is a whole sentence saying why the app can't update itself; the second is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ Ziehe %2$@ in deinen Ordner „Programme“, um es zu installieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Drag %2$@ to your Applications folder to install it."
          }
        }
      }
    },
    "%@ will reopen in a moment." : {
      "comment" : "Update window, just before the app quits to relaunch. The argument is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ wird gleich wieder geöffnet."
          }
        }
      }
    },
