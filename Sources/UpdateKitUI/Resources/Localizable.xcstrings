{
  "sourceLanguage" : "en-GB",
  "strings" : {
    "%@ %@ is available" : {
      "comment" : "An update has been published. The arguments are the app's name and the new version number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ ist verfügbar"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is available"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ ya está disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ est disponible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ è disponibile"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ está disponível"
          }
        }
      }
    },
    "%@ %@ is the latest version." : {
      "comment" : "Alert text after Check for Updates finds nothing newer. The arguments are the app's name and its version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ ist die neueste Version."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is the latest version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ es la versión más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ est la dernière version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ è la versione più recente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ é a versão mais recente."
          }
        }
      }
    },
    "%@ Downloading opens the disk image — drag %@ to your Applications folder to finish installing it." : {
      "comment" : "Update dialog. The first argument is a whole sentence saying why the app can't update itself; the second is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Nach dem Herunterladen öffnet sich das Disk-Image – ziehe %2$@ in deinen Ordner „Programme“, um die Installation abzuschließen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Downloading opens the disk image — drag %2$@ to your Applications folder to finish installing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Al descargar se abre la imagen de disco — arrastra %2$@ a tu carpeta Aplicaciones para completar la instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Le téléchargement ouvre l’image disque — faites glisser %2$@ dans votre dossier Applications pour terminer l’installation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Il download apre l’immagine disco — trascina %2$@ nella cartella Applicazioni per completare l’installazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ O download abre a imagem de disco — arraste %2$@ para a pasta Aplicativos para concluir a instalação."
          }
        }
      }
    },
    "%@ Drag %@ to your Applications folder to install it." : {
      "comment" : "Tooltip on the Download Disk Image button. The first argument is a whole sentence saying why the app can't update itself; the second is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ziehe %2$@ in deinen Ordner „Programme“, um es zu installieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Drag %2$@ to your Applications folder to install it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Arrastra %2$@ a tu carpeta Aplicaciones para instalar la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Faites glisser %2$@ dans votre dossier Applications pour l’installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Trascina %2$@ nella cartella Applicazioni per installarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Arraste %2$@ para a pasta Aplicativos para instalá-lo."
          }
        }
      }
    },
    "%@ will reopen in a moment." : {
      "comment" : "Update window, just before the app quits to relaunch. The argument is the app's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird gleich wieder geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se volverá a abrir en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va se rouvrir dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si riaprirà tra un momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será reaberto em instantes."
          }
        }
      }
    },
    "A newer version is available." : {
      "comment" : "Update dialog text when there are no release notes.",
