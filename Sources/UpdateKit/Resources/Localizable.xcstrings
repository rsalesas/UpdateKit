    "expected %@, received %@" : {
      "comment" : "Reason inside \"Couldn't download the update: %@\". The arguments are exact sizes, e.g. \"5,242,880 bytes\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
